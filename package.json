{
  "name": "careloop",
  "version": "0.1.0",
  "description": "Checks hospital discharge decisions against booked community care and books a home visit on confirmation. Built at the Anima x OpenAI hackathon.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"node --watch dashboard/server.js\" \"vite --config dashboard/vite.config.js\"",
    "dev:api": "node --watch dashboard/server.js",
    "dev:web": "vite --config dashboard/vite.config.js",
    "build": "vite build --config dashboard/vite.config.js",
    "preview": "vite preview --config dashboard/vite.config.js",
    "start": "PORT=3000 node dashboard/server.js",
    "test": "node --test dashboard/src/model.test.js dashboard/sweep.test.js dashboard/booking.test.js dashboard/discharges.test.js"
  },
  "dependencies": {
    "@animahealth/adk": "^0.6.0",
    "openai": "^5.23.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "vite": "^7.1.5"
  }
}
